# 复制本文件为 .env 并填入你的 API key（.env 已在 .gitignore 中，不会提交）
# 智谱 API key（候选链中 zhipu 前缀模型使用）
ZHIPU_API_KEY=your_api_key_here
# 视觉模型链（逗号分隔，按优先级自动故障转移：限流/失败自动切换下一个）
# 格式 provider:model，provider 缺省为 zhipu（智谱）；mimo:/kimi:/openai:/qwen:/gemini:/siliconflow: 前缀走对应服务商
# 默认链 = 智谱免费模型 + mimo 收费兜底（智谱 429 限流时自动切 mimo）
VISION_MODEL_CHAIN=glm-4.6v-flash,glm-4.1v-thinking-flash,glm-4v-flash,mimo:mimo-v2.5,mimo:mimo-v2-omni
# 兼容旧配置：VISION_MODEL_CHAIN 未设置时使用此模型
ZHIPU_MODEL=glm-4.6v-flash
# 可选的 API base URL（一般无需修改）
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 小米 mimo API key（默认链的收费兜底；在小米 mimo 开放平台获取）
MIMO_API_KEY=your_mimo_api_key_here
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# ---- 以下收费模型均为可选（可配置）：配好 key 后追加到 VISION_MODEL_CHAIN 即自动参与故障转移，
# ---- 或调用 analyze_image 时用 model 参数临时指定（如 model=kimi:kimi-k3）；留空则对应 provider 自动跳过，不会产生任何费用
# 月之暗面 kimi（https://platform.moonshot.cn 获取；视觉模型如 kimi-k3 / kimi-k2.6）
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# OpenAI GPT（https://platform.openai.com 获取；视觉模型如 gpt-4o / gpt-4o-mini）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# 阿里百炼 qwen（https://bailian.console.aliyun.com 获取；视觉模型如 qwen-vl-max / qwen3.8-max）
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Google Gemini（https://aistudio.google.com 获取；视觉模型如 gemini-2.5-flash）
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 硅基流动（https://cloud.siliconflow.cn 获取；开源视觉模型聚合，如 Qwen/Qwen2.5-VL-72B-Instruct）
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 单次请求超时毫秒（默认 60000）
# VISION_TIMEOUT_MS=60000
